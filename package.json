{
  "name": "@kungfu-tech/site-kungfu-pub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4327",
    "build": "astro build && pagefind --site dist",
