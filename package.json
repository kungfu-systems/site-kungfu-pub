    "check": "astro check && node scripts/check-content.mjs && node --experimental-strip-types --test scripts/test-competitor-workbook.mjs scripts/test-learner-practices.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "astro": "7.3.1",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pagefind": "^1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=12.0.0"
  }
}
