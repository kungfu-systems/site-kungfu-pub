---
import '../styles/global.css';
import Header from '../components/Header';
interface Props {
  title?: string;
  description?: string;
  section?: string;
}
const {
  title = '学会 Agent，看见下一步。',
  description = '功夫酒馆：面向中文读者的 Agent 学习路线、精选资料与行业观察。',
  section = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ee" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={`${title} — 功夫酒馆`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — 功夫酒馆</title>
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>
    <Header client:load section={section} />
    <main id="main" data-pagefind-body><slot /></main>
    <footer class="site-footer container" data-pagefind-ignore>
      <div>
        <a href="/" class="footer-brand">功夫酒馆</a><p>学习有路径，观察有依据。</p>
      </div>
      <div class="footer-links">
        <a href="/about/">关于本站</a><a href="/about/#standards">内容标准</a><a href="/careers/"
          >职业雷达</a
        >
      </div>
      <div class="footer-note">
        <span>为中文 Agent 实践者而建</span><small>本地预览版</small>
      </div>
      <div class="footer-legal">
        <span>Copyright © 2017 - 2026</span>
        <span>北京功夫源科技发展有限责任公司</span>
        <a
          href="https://beian.miit.gov.cn/#/Integrated/index"
          target="_blank"
          rel="noopener noreferrer">京ICP备19056728号-1</a
        >
        <a
          class="public-security-filing"
          href="https://beian.mps.gov.cn/#/query/webSearch?code=11010202010762"
          target="_blank"
          rel="noopener noreferrer"
          ><img src="/images/public-security-filing.png" alt="" width="15" height="16" />
          京公网安备11010202010762</a
        >
        <div class="footer-policy-links">
          <a
            href="https://www.kungfu-trader.com/index.php/user_agreement/"
            target="_blank"
            rel="noopener noreferrer">[用户协议]</a
          >
          <a
            href="https://www.kungfu-trader.com/index.php/privacy_policy/"
            target="_blank"
            rel="noopener noreferrer">[隐私政策]</a
          >
          <a
            href="https://www.kungfu-trader.com/index.php/disclaimer/"
            target="_blank"
            rel="noopener noreferrer">[法律声明]</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
