---
import Base from '../../layouts/Base.astro';
import catalog from '../../data/catalog.json';
import { ArrowUpRight } from 'lucide-react';
---

<Base title="趋势观察" section="trends"
  ><div class="container page-content">
    <div class="page-heading">
      <span class="eyebrow">FIELD NOTES / 趋势观察</span><h1>关心变化，也追问依据。</h1><p>
        从官方资料与公开来源出发，把技术、实践和职业发展连接起来。<br
        />首期提供编辑导读与观察方法，后续逐步加入有来源的定期追踪。
      </p>
    </div><div class="trend-feature">
      <span class="eyebrow">我们的观察方式</span><h2>
        先回到原始来源，<br />再讨论它意味着什么。
      </h2><p>
        每篇观察都区分来源事实、编辑判断和待验证问题。<br
        />关注度和产品发布，不直接等于实际采用或招聘增长。
      </p><a class="text-link" href="/about/#standards">了解内容标准 <ArrowUpRight size={18} /></a>
    </div><div class="observation-list wide">
      {
        catalog.observations.map((o, i) => (
          <a class="observation-row" href={`/trends/${o.id}/`}>
            <>
              <span class="observation-index">0{i + 1}</span>
              <div>
                <>
                  <div class="observation-meta">
                    <>
                      <span>{o.category}</span>
                      <span>{o.kind}</span>
                      <span>2026.09.07</span>
                    </>
                  </div>
                  <h3>{o.title}</h3>
                  <p>{o.description}</p>
                  <small>来源：{o.source}</small>
                </>
              </div>
              <ArrowUpRight size={21} />
            </>
          </a>
        ))
      }
    </div>
  </div></Base
>
