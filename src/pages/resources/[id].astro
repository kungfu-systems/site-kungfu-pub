---
import Base from '../../layouts/Base.astro';
import catalog from '../../data/catalog.json';
import { ArrowUpRight } from 'lucide-react';
export function getStaticPaths() {
  return catalog.resources.map((resource) => ({
    params: { id: resource.id },
    props: { resource },
  }));
}
const { resource: r } = Astro.props;
---

<Base title={r.title} description={r.description} section="resources">
  <div class="container article-container">
    <a href="/resources/" class="breadcrumb">← 返回资料库</a>
    <div class="page-heading compact">
      <div class="eyebrow">{r.category} / {r.type}</div><h1>{r.title}</h1><p>{r.description}</p>
    </div>
    <div class="article-metadata">
      <span>{r.source}</span><span>{r.language} · {r.level}</span><span
        >资料核对 <time datetime={r.checkedAt}>{r.checkedAt}</time></span>
    </div>
    <a class="button primary" href={r.url} target="_blank" rel="noopener noreferrer"
      >打开原始资料 <ArrowUpRight size={18} /></a
    >
    <div class="prose">
      <h2>适合谁，开始前需要什么</h2><p>{r.prerequisite}</p>
      <h2>建议从哪里开始</h2><p>{r.start}</p>
      <h2>可以尝试做出什么</h2><p>{r.outcome}</p><p>
        这是酒馆建议的练习目标，不代表已完成课程，也不是就业承诺。
      </p>
      <h2>阅读、账号与费用</h2><p>{r.access}</p>
      <h2>版本与核对说明</h2><p>{r.reviewNote}</p>
      <h2>来源</h2><p>
        <a href={r.url} target="_blank" rel="noopener noreferrer">{r.source} · 阅读入口 ↗</a>
      </p>
      {
        r.sourceUrl !== r.url && (
          <p>
            <a href={r.sourceUrl} target="_blank" rel="noopener noreferrer">
              作者项目仓库与目录 ↗
            </a>
          </p>
        )
      }
      <p>
        本站提供原创导读和来源指针，正文由原作者维护。核对限于公开介绍、目录或说明，不代表完成全部课程或实测所有示例。外站可达性、账号地区、语言覆盖与服务收费可能变化。
      </p>
    </div>
  </div>
</Base>
